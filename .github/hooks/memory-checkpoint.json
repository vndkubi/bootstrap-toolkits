{
  "version": 1,
  "hooks": {
    "preCompact": [
      {
        "type": "command",
        "bash": "command -v node >/dev/null 2>&1 && node .github/scripts/memory-checkpoint.js || exit 0",
        "powershell": "if (Get-Command node -ErrorAction SilentlyContinue) { & node .github/scripts/memory-checkpoint.js }; exit 0",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
