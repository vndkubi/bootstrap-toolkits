    "skills": [],
    "mcp": [],
    "tools": []
  },
  "inputs": [
    "`baseUrl` — from `run-local-stack` healthcheck output.",
    "`contracts/<protocol>.{yaml|graphql|proto}` — reviewed contract.",
    "`featureWorkspace` — `specs/<id>-<slug>/`.",
    "`spec.md` — ACs with ids."
  ],
  "outputs": [
    "review findings",
    "task list",
    "tests"
