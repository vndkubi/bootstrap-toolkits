{
  "schemaVersion": 1,
  "id": "update-spec",
  "displayName": "update-spec",
  "description": "Incrementally update an existing feature workspace when change requests arrive. Patches spec.md first, then updates affected downstream artifacts such as plan.md, research.md, data-model.md, contracts/, quickstart.md, and tasks.md.",
  "version": "0.6.0",
  "tier": "domain",
  "stability": "stable",
  "requires": {
    "skills": [],
    "mcp": [],
    "tools": []
  },
  "inputs": [
    "change request or review feedback",
    "feature workspace under `specs/<feature-id>-<slug>/`"
  ],
  "outputs": [
    "plan",
    "report",
    "review findings",
    "task list",
    "tests"
  ],
  "triggers": [
    "affected",
    "arrive",
    "artifacts",
    "change",
    "contracts",
    "data",
    "downstream",
    "existing",
    "feature",
    "first",
    "incrementally",
    "model"
  ],
  "mcp_tools_used": [],
  "invocationMode": "agent_delegated",
  "paths": {
    "skill": ".github/skills/update-spec/SKILL.md",
    "scripts": ".github/skills/update-spec/scripts",
    "assets": ".github/skills/update-spec/assets",
    "references": ".github/skills/update-spec/references"
  },
  "keywords": [
    "affected",
    "arrive",
    "artifacts",
    "change",
    "contracts",
    "data",
    "downstream",
    "existing",
    "feature",
    "first",
    "incrementally",
    "model"
  ],
  "routedBy": [
    "business-analyst",
    "spec-reviewer"
  ],
  "referencedByAgents": [
    "business-analyst",
    "spec-reviewer"
  ]
}
