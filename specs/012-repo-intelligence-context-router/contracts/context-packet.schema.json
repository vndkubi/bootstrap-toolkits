{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specs/012-repo-intelligence-context-router/contracts/context-packet.schema.json",
  "title": "Repo intelligence context packet",
  "type": "object",
  "required": ["task", "budget", "candidate_files", "editable_snippets", "related_tests", "validation", "next_actions"],
  "properties": {
    "task": {
      "type": "object",
      "required": ["summary", "intent"],
      "properties": {
        "summary": { "type": "string", "maxLength": 1200 },
        "domain": { "type": "string" },
        "intent": { "enum": ["ask", "debug", "edit", "review", "test", "migration", "unknown"] },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["estimated_tokens", "max_tokens", "omitted_results"],
      "properties": {
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "omitted_results": { "type": "integer", "minimum": 0 },
        "omitted_reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "domain_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/domainRule" },
      "default": []
    },
    "candidate_files": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/searchResult" }
    },
    "editable_snippets": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/searchResult" }
    },
    "related_contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/searchResult" },
      "default": []
    },
    "related_tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/testTarget" }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "reason"],
        "properties": {
          "command": { "type": "string" },
          "reason": { "type": "string" },
          "expected_signal": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "searchResult": {
      "type": "object",
      "required": ["file", "lines", "why_relevant", "confidence"],
      "properties": {
        "file": { "type": "string" },
        "symbol": { "type": "string" },
        "symbol_id": { "type": "string" },
        "lines": { "type": "string", "pattern": "^[0-9]+-[0-9]+$" },
        "snippet": { "type": "string", "maxLength": 8000 },
        "why_relevant": { "type": "string", "maxLength": 600 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "domainRule": {
      "type": "object",
      "required": ["domain", "invariant", "source_path", "confidence"],
      "properties": {
        "domain": { "type": "string" },
        "entity_or_flow": { "type": "string" },
        "invariant": { "type": "string", "maxLength": 600 },
        "source_path": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "testTarget": {
      "type": "object",
      "required": ["test_id", "file", "command"],
      "properties": {
        "test_id": { "type": "string" },
        "file": { "type": "string" },
        "command": { "type": "string" },
        "covers_symbols": { "type": "array", "items": { "type": "string" } },
        "avg_runtime_ms": { "type": "integer", "minimum": 0 },
        "flaky_score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  }
}
