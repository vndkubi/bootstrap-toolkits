{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specs/012-repo-intelligence-context-router/contracts/repo-intel-tools.schema.json",
  "title": "Repo intelligence MCP tool schemas",
  "description": "Input and output contracts for bounded repo intelligence tools. Each tool returns clipped, line-ranged, confidence-scored context instead of full files by default.",
  "type": "object",
  "$defs": {
    "ResultEnvelope": {
      "type": "object",
      "required": ["results", "omitted", "next_action"],
      "properties": {
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/CodeResult" }
        },
        "omitted": { "type": "integer", "minimum": 0 },
        "next_action": { "type": "string", "maxLength": 800 },
        "cache_key": { "type": "string" }
      },
      "additionalProperties": false
    },
    "CodeResult": {
      "type": "object",
      "required": ["file", "lines", "why_relevant", "confidence"],
      "properties": {
        "file": { "type": "string" },
        "symbol": { "type": "string" },
        "symbol_id": { "type": "string" },
        "lines": { "type": "string", "pattern": "^[0-9]+-[0-9]+$" },
        "snippet": { "type": "string", "maxLength": 8000 },
        "why_relevant": { "type": "string", "maxLength": 600 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "ValidationCommand": {
      "type": "object",
      "required": ["command", "reason"],
      "properties": {
        "command": { "type": "string" },
        "reason": { "type": "string" },
        "expected_signal": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "repo.search_code": {
      "input": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 2 },
          "mode": { "enum": ["exact", "semantic", "hybrid"], "default": "hybrid" },
          "domain": { "type": "string" },
          "top_k": { "type": "integer", "minimum": 1, "maximum": 20, "default": 8 },
          "max_chars": { "type": "integer", "minimum": 500, "maximum": 20000, "default": 6000 },
          "detail": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      },
      "output": { "$ref": "#/$defs/ResultEnvelope" }
    },
    "repo.lookup_symbol": {
      "input": {
        "type": "object",
        "required": ["name_or_path"],
        "properties": {
          "name_or_path": { "type": "string", "minLength": 1 },
          "top_k": { "type": "integer", "minimum": 1, "maximum": 20, "default": 8 },
          "max_chars": { "type": "integer", "minimum": 500, "maximum": 20000, "default": 6000 }
        },
        "additionalProperties": false
      },
      "output": { "$ref": "#/$defs/ResultEnvelope" }
    },
    "repo.get_file_slice": {
      "input": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "lines": { "type": "string", "pattern": "^[0-9]+-[0-9]+$" },
          "symbol_id": { "type": "string" },
          "max_chars": { "type": "integer", "minimum": 500, "maximum": 20000, "default": 8000 }
        },
        "additionalProperties": false
      },
      "output": { "$ref": "#/$defs/ResultEnvelope" }
    },
    "repo.get_related_files": {
      "input": {
        "type": "object",
        "required": ["path_or_symbol"],
        "properties": {
          "path_or_symbol": { "type": "string" },
          "relation": { "enum": ["import", "test", "route", "schema", "migration", "event", "all"], "default": "all" },
          "top_k": { "type": "integer", "minimum": 1, "maximum": 20, "default": 8 },
          "max_chars": { "type": "integer", "minimum": 500, "maximum": 20000, "default": 6000 }
        },
        "additionalProperties": false
      },
      "output": { "$ref": "#/$defs/ResultEnvelope" }
    },
    "context.build_packet": {
      "input": {
        "type": "object",
        "required": ["task"],
        "properties": {
          "task": { "type": "string", "minLength": 5 },
          "domain": { "type": "string" },
          "max_tokens": { "type": "integer", "minimum": 2000, "maximum": 100000, "default": 30000 },
          "max_candidate_files": { "type": "integer", "minimum": 1, "maximum": 20, "default": 8 }
        },
        "additionalProperties": false
      },
      "output": {
        "$ref": "context-packet.schema.json"
      }
    },
    "test.find_related": {
      "input": {
        "type": "object",
        "required": ["changed_files_or_symbols"],
        "properties": {
          "changed_files_or_symbols": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "top_k": { "type": "integer", "minimum": 1, "maximum": 50, "default": 12 }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": ["tests", "validation"],
        "properties": {
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["test_id", "file", "command", "confidence"],
              "properties": {
                "test_id": { "type": "string" },
                "file": { "type": "string" },
                "command": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            }
          },
          "validation": {
            "type": "array",
            "items": { "$ref": "#/$defs/ValidationCommand" }
          }
        },
        "additionalProperties": false
      }
    },
    "test.run_targeted": {
      "input": {
        "type": "object",
        "required": ["test_ids"],
        "properties": {
          "test_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "max_log_chars": { "type": "integer", "minimum": 1000, "maximum": 50000, "default": 12000 }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": ["status", "log_excerpt"],
        "properties": {
          "status": { "enum": ["passed", "failed", "error"] },
          "log_excerpt": { "type": "string", "maxLength": 50000 },
          "failure_summary": { "type": "string", "maxLength": 2000 },
          "next_action": { "type": "string", "maxLength": 800 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
