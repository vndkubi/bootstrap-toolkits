{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace.schema.json",
  "title": "AI Team Task Trace",
  "type": "object",
  "required": ["schema_version", "trace_id", "task_id", "started_at", "role", "requested_model", "model_qualification", "execution_profile", "actual_model", "fallback_reason", "skills", "acceptance_ids", "evidence", "decisions", "token_usage", "latency_ms", "human_corrections", "outcome"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 2},
    "trace_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "role": {"type": "string", "minLength": 1},
    "requested_model": {"type": "string", "minLength": 1},
    "model_qualification": {"enum": ["unqualified", "standard", "high-autonomy"]},
    "execution_profile": {"enum": ["compatibility-strict", "standard", "high-autonomy"]},
    "actual_model": {"type": ["string", "null"]},
    "fallback_reason": {"type": ["string", "null"]},
    "skills": {"type": "array", "items": {"type": "string"}},
    "acceptance_ids": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "claim", "confidence"],
        "properties": {
          "source": {"type": "string"},
          "claim": {"type": "string"},
          "confidence": {"enum": ["CONFIRMED", "INFERRED", "UNKNOWN"]}
        },
        "additionalProperties": false
      }
    },
    "decisions": {"type": "array", "items": {"type": "object"}},
    "token_usage": {
      "type": "object",
      "required": ["input", "output", "reasoning"],
      "properties": {
        "input": {"type": ["integer", "null"], "minimum": 0},
        "output": {"type": ["integer", "null"], "minimum": 0},
        "reasoning": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "human_corrections": {"type": ["integer", "null"], "minimum": 0},
    "outcome": {
      "type": "object",
      "required": ["status", "summary", "verification"],
      "properties": {
        "status": {"enum": ["started", "passed", "failed", "partial", "blocked", "example"]},
        "summary": {"type": "string"},
        "verification": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
