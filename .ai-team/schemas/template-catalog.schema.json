{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template-catalog.schema.json",
  "title": "AI Team Template Catalog",
  "type": "object",
  "required": ["schema_version", "catalog_version", "templates"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "catalog_version": {"type": "string", "minLength": 1},
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "phase", "owner_role", "description", "default_output", "required_markers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "path": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "owner_role": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 20},
          "default_output": {"type": "string", "minLength": 1},
          "required_markers": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
