{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-result.schema.json",
  "title": "AI Team Benchmark Result",
  "type": "object",
  "required": ["schema_version", "run_id", "suite_id", "created_at", "measured", "candidates", "decision"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "measured": {"type": "boolean"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["execution_profile", "provider", "model", "reasoning", "toolset", "skill_version", "eval_results"],
        "properties": {
          "execution_profile": {"enum": ["compatibility-strict", "standard", "high-autonomy"]},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string"},
          "reasoning": {"type": "string", "minLength": 1},
          "toolset": {"type": "array", "items": {"type": "string"}},
          "skill_version": {"type": "string", "minLength": 1},
          "eval_results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["eval_id", "outcome_score", "critical_failure", "human_corrections", "latency_ms", "input_tokens", "output_tokens", "cost_usd"],
              "properties": {
                "eval_id": {"type": "string"},
                "outcome_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                "critical_failure": {"type": ["boolean", "null"]},
                "human_corrections": {"type": ["integer", "null"], "minimum": 0},
                "latency_ms": {"type": ["integer", "null"], "minimum": 0},
                "input_tokens": {"type": ["integer", "null"], "minimum": 0},
                "output_tokens": {"type": ["integer", "null"], "minimum": 0},
                "cost_usd": {"type": ["number", "null"], "minimum": 0},
                "notes": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": ["status", "reason", "approved_by"],
      "properties": {
        "status": {"enum": ["example", "promote", "reject", "needs-more-evidence"]},
        "reason": {"type": "string"},
        "approved_by": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
